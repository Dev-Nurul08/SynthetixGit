# ─── SynthetixGit Environment Variables ───────────────────────────────────────
# Copy this file to `.env.local` for local development.
# On Vercel: Project → Settings → Environment Variables → add each key below.

# Public canonical URL (used for OAuth redirects & README badge links)
# Local: http://localhost:3000
# Production: https://synthetixgit.vercel.app  (or your custom domain)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── GitHub OAuth App (required for "Connect with GitHub" deploy) ─────────────
# Create at: https://github.com/settings/developers → OAuth Apps → New OAuth App
#
#   Application name:  SynthetixGit
#   Homepage URL:      https://synthetixgit.vercel.app
#   Callback URL:      https://synthetixgit.vercel.app/api/auth/github/callback
#
# For local dev, add a second callback: http://localhost:3000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── Server-side GitHub API token (optional but recommended) ──────────────────
# Increases GitHub API rate limits for profile scanning (/api/user/scan).
# Create a classic PAT with `public_repo` scope (no repo write needed for scanning).
GITHUB_TOKEN=
# Alias also supported:
# GITHUB_PERSONAL_ACCESS_TOKEN=
